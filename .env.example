# Database Configuration (Docker container runs on port 5433 by default)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=asset_copilot
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# LLM Provider Configuration
# Groq API key (Primary provider)
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API key for accessing Google Gemma models
OPEN_ROUTER_API_KEY=your_openrouter_api_key_here

# Google AI Studio API key (optional fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection (Task-Specific OpenRouter Free Tier)
PRIMARY_MODEL=openrouter/nvidia/nemotron-3.5-lightning:free
FALLBACK_MODEL=openrouter/openrouter/free
MODEL_TOOL_PLANNER=openrouter/nvidia/nemotron-3.5-lightning:free
MODEL_REASONER=openrouter/nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
MODEL_SYNTHESIZER=openrouter/minimax/minimax-m3.1-flash:free
MODEL_SAFETY_NET=openrouter/openrouter/free
MODEL_TEMPERATURE=0.0
MODEL_MAX_TOKENS=4096

# Langfuse Observability Configuration
# Obtain keys from your Langfuse Cloud project settings: https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=development
LANGFUSE_ENABLED=true
