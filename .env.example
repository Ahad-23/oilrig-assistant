# Database Configuration (Docker container runs on port 5433 by default)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=asset_copilot
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# LLM Provider Configuration
# OpenRouter API key for accessing Google Gemma models
OPEN_ROUTER_API_KEY=your_openrouter_api_key_here

# Google AI Studio API key (optional fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection
PRIMARY_MODEL=openrouter/google/gemma-4-26b-a4b-it
FALLBACK_MODEL=openrouter/google/gemma-4-31b-it
MODEL_TEMPERATURE=0.0
MODEL_MAX_TOKENS=4096

# Langfuse Observability Configuration
# Obtain keys from your Langfuse Cloud project settings: https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=development
LANGFUSE_ENABLED=true
